{
  "name": "client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "type-check": "vue-tsc --build",
    "copy-404": "node scripts/copy-404.mjs",
    "generate-icon-names": "node scripts/generate-icon-names.mjs",

    "build-only": "vite build",
    "build-only:dev": "vite build --mode development",

    "build": "run-s type-check build-only copy-404",
    "build:dev": "run-s type-check build-only:dev",

    "preview": "vite preview",
    "preview:dev": "npm run build:dev && vite preview"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@types/lodash-es": "^4.17.12",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.19.0",
    "date-fns": "^4.4.0",
    "lodash-es": "^4.18.1",
    "pinia": "^4.0.2",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "vuetify": "^4.1.9"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.98",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.2",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
